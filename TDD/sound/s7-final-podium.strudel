// S7 — Final Podium (final standings appear, once per game)
// Status: DONE (owner-approved 2026-07-19)
// The match-end fanfare — the ONLY grand fanfare in the game: S4's winner motif stated,
// then answered a step higher, with the second landing getting the warm Fmaj7 (M2's e-piano
// voice), a tuba root, and one high sparkle. Plays over silence (M5 cut) the instant the
// ranked standings screen (scores + title badges) appears after the title ceremony.
// In Streamlined mode (badges-only, no ceremony) this is the only wrap-up sound at all.
// Render: one cycle (~4 s + tail), one-shot.
// Paste into https://strudel.cc — spec: TDD/sound/stinger-sfx-spec.md

setcpm(15)
// One cycle = 4 s: duh duh duh-DUH... duh duh duh-DAAAH (higher). Render one cycle.

stack(
  // LEAD — S4's motif, then the higher answer
  n("3 ~ 3 ~ [3 4] 5@3 5 ~ 5 ~ [5 6] 7@3")
    .scale("F4:major:pentatonic")
    .sound("gm_marimba")
    .attack(.001).decay(.18).sustain(.1).release(.15)
    .gain(.5),

  // Tuba roots under both landings only
  note("~@5 f2@3 ~@5 f2@3").sound("gm_tuba")
    .attack(.002).decay(.3).sustain(0).gain(.5),

  // Final landing only: warm Fmaj7 + one high sparkle
  note("~@13 [f3,a3,c4,e4]@3").sound("gm_epiano1")
    .attack(.01).decay(.5).sustain(.3).release(.5)
    .lpf(2800).gain(.4),
  n("~@13 7@3").scale("F5:major:pentatonic").sound("gm_marimba")
    .attack(.001).decay(.25).sustain(0).gain(.35)
)
.room(.3).size(4)
